# Node 24. Copy to .env; never commit real credentials.

#-- API
PORT=26090
API_ORIGIN=http://localhost:26090
SITE_URL=http://localhost:3000
DEFAULT_DOMAINS=inkbyte.app,inkbyte.co

#-- Database
# Local development uses the Compose postgres service:
#   DATABASE_URL=postgresql://postgres:REPLACE@localhost:5432/inkbyte
# Production uses Neon. Copy the connection string from the Neon console.
DATABASE_URL=postgresql://postgres:REPLACE@localhost:5432/inkbyte
MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE@localhost:5432/inkbyte
DATABASE_SSL=disable
DATABASE_POOL_MAX=8
DATABASE_ACQUIRE_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=10000

#-- Clerk
# Create a dedicated Clerk application for InkByte. The issuer is the
# instance host, for example https://clerk.example.com
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=

#-- Website (also read from packages/website/.env.local)
INKBYTE_API_URL=http://localhost:26090
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

#-- Tests
# The database name must end in _test; the harness refuses anything else.
TEST_DATABASE_URL=postgresql://postgres:REPLACE@localhost:5432/inkbyte_test
