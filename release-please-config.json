{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.6.0/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "component": "inkbyte",
      "release-type": "node",
      "versioning": "always-bump-patch",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "include-v-in-release-name": true,
      "force-tag-creation": false,
      "prerelease": true,
      "pull-request-title-pattern": "chore(release): release ${version}",
      "pull-request-footer": "Source release only. Deployment, artifact acceptance and store submission are separate operations.",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/api/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/website/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "feature", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "revert", "section": "Reverts" }
  ]
}
