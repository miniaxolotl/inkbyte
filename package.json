{
  "name": "@monorepo/inkbyte",
  "private": true,
  "type": "module",
  "author": "Bramble Labs Inc.",
  "version": "0.1.0",
  "description": "InkByte — short links, QR codes and link analytics.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miniaxolotl/inkbyte.git"
  },
  "homepage": "https://inkbyte.app",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @miniaxolotl/inkbyte-server --filter website dev",
    "dev:api": "pnpm --filter @miniaxolotl/inkbyte-server dev",
    "dev:website": "pnpm --filter website dev",
    "build": "node scripts/build.mjs api && pnpm build:website",
    "build:api": "node scripts/build.mjs api",
    "build:website": "pnpm --filter website build",
    "start": "pnpm --filter @miniaxolotl/inkbyte-server start",
    "start:website": "pnpm --filter website start",
    "lint": "eslint lib packages/api/src scripts tests/src",
    "lint:website": "pnpm --filter website lint",
    "lint:fix": "pnpm lint --fix",
    "check-types": "tsc --noEmit && pnpm --filter website typecheck",
    "test": "pnpm --filter @monorepo/tests test",
    "test:db:setup": "tsx scripts/database/src/test-bootstrap.ts",
    "db:migrate": "pnpm --filter @miniaxolotl/inkbyte-server migrate",
    "db:seed": "pnpm --filter @miniaxolotl/inkbyte-server seed",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "services:restart": "pnpm run services:down && pnpm run services:up",
    "services:logs": "docker compose logs -f",
    "services:ps": "docker compose ps",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,css,md,json}\"",
    "clean": "rm -rf packages/*/dist packages/*/.next packages/*/*.tsbuildinfo node_modules"
  },
  "devDependencies": {
    "@lib/eslint-config": "workspace:*",
    "@lib/typescript-config": "workspace:*",
    "@types/node": "~24.19.2",
    "esbuild": "~0.28.2",
    "eslint": "~9.39.5",
    "prettier": "~3.9.10",
    "tsx": "~4.23.15",
    "typescript": "~6.0.3"
  }
}
