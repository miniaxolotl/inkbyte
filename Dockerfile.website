FROM node:24-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter website build

FROM node:24-bookworm-slim AS production
LABEL org.opencontainers.image.source="https://github.com/miniaxolotl/inkbyte" \
      org.opencontainers.image.title="InkByte website" \
      org.opencontainers.image.description="InkByte marketing site and dashboard" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="Bramble Labs Inc."
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app/packages/website/.next/standalone ./
COPY --from=build --chown=node:node /app/packages/website/.next/static ./packages/website/.next/static
COPY --from=build --chown=node:node /app/packages/website/public ./packages/website/public
USER node
EXPOSE 3000
HEALTHCHECK --interval=20s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || '3000') + '/').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["node", "packages/website/server.js"]
