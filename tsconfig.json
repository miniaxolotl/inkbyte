{
  "extends": "./lib/typescript-config/base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["es2022"]
  },
  "include": [
    "lib/*/src/**/*.ts",
    "packages/api/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/src/**/*.ts"
  ],
  "exclude": ["node_modules", "packages/website"]
}
