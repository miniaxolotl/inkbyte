{
  "extends": "./lib/typescript-config/base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["es2022"]
  },
  "include": [
    "lib/*/src/**/*.ts",
    "packages/api/src/**/*.ts",
    "scripts/validate-env.ts",
    "tests/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "packages/website",
    "scripts/database/src",
    "scripts/screenshots/src"
  ]
}
